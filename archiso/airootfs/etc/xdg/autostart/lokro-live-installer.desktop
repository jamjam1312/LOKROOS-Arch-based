[Desktop Entry]
Type=Application
Name=Install LOKRO OS
Name[de]=LOKRO OS installieren
Comment=Start the guided disk installation
Comment[de]=Geführte Installation auf die Festplatte starten
Exec=/usr/local/bin/lokro-live-installer
Icon=system-software-install
Terminal=false
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
X-KDE-StartupNotify=true
