[Unit]
Description=Start the LOKRO installer inside the active Plasma live session
Documentation=https://github.com/jamjam1312/LOKROOS-Arch-based
After=lokro-live-user.service sddm.service
Wants=sddm.service
ConditionPathExists=/run/archiso/bootmnt

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/sbin/lokro-live-installer-supervisor
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
