// The live session has no reusable administrator password. Permit only the
// live user to start Calamares through its upstream Polkit action. This file
// exists only in the live image and is removed from the installed target.
polkit.addRule(function(action, subject) {
    if (action.id === "com.github.calamares.calamares.pkexec.run" &&
        subject.user === "liveuser") {
        return polkit.Result.YES;
    }
});
