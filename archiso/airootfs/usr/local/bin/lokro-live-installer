#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

if [[ "$(id -un)" != liveuser ]] || [[ ! -e /run/archiso/bootmnt ]]; then
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title 'LOKRO OS Installer' --sorry \
            'Der Installer ist nur im gestarteten LOKRO-Live-System verfügbar.' >/dev/null 2>&1 || true
    fi
    exit 1
fi

if pgrep -x calamares >/dev/null 2>&1; then
    exit 0
fi

exec /usr/bin/sudo -E /usr/bin/calamares -d
