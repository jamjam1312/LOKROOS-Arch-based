#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
if ! id liveuser >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --groups wheel,audio,video,storage,input,lp,network liveuser
    passwd --delete liveuser
fi
install -d -m 0755 -o liveuser -g liveuser /home/liveuser/Desktop
install -m 0755 -o liveuser -g liveuser \
    /etc/xdg/autostart/lokro-live-installer.desktop \
    /home/liveuser/Desktop/Install-LOKRO-OS.desktop
chown -R liveuser:liveuser /home/liveuser
