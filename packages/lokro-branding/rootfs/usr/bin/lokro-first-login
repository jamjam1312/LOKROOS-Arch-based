#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/lokro"
stamp="$config_dir/first-login-v7"
previous_stamp_v6="$config_dir/first-login-v6"
previous_stamp_v5="$config_dir/first-login-v5"
previous_stamp_v4="$config_dir/first-login-v4"
[[ -e "$stamp" ]] && exit 0
mkdir -p "$(dirname "$stamp")"

fresh_layout=true
if [[ -e "$previous_stamp_v6" || -e "$previous_stamp_v5" || -e "$previous_stamp_v4" ]]; then
    fresh_layout=false
fi

if [[ "$fresh_layout" == true ]] && command -v plasma-apply-lookandfeel >/dev/null 2>&1; then
    plasma-apply-lookandfeel --apply org.lokro.dark >/dev/null 2>&1 || true
fi
if command -v plasma-apply-colorscheme >/dev/null 2>&1; then
    plasma-apply-colorscheme LokroDark >/dev/null 2>&1 || true
fi
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage org.lokro.dark >/dev/null 2>&1 || true
    kwriteconfig6 --file kdeglobals --group Icons --key Theme breeze-dark >/dev/null 2>&1 || true
    kwriteconfig6 --file plasmarc --group Theme --key name lokro-black >/dev/null 2>&1 || true
    kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme LokroMono >/dev/null 2>&1 || true
    kwriteconfig6 --file kcminputrc --group Mouse --key cursorSize 24 >/dev/null 2>&1 || true
fi
if command -v plasma-apply-cursortheme >/dev/null 2>&1; then
    plasma-apply-cursortheme LokroMono >/dev/null 2>&1 || true
fi
if command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default lokro-action-handler.desktop x-scheme-handler/lokro-action >/dev/null 2>&1 || true
    for mime in audio/mpeg audio/flac audio/ogg audio/x-wav audio/mp4 \
        video/mp4 video/x-matroska video/webm video/mpeg application/ogg; do
        xdg-mime default lokro-media.desktop "$mime" >/dev/null 2>&1 || true
    done
fi

layout_applied=true
if command -v qdbus6 >/dev/null 2>&1; then
    if [[ "$fresh_layout" == true ]]; then
        script="$(cat /usr/share/plasma/look-and-feel/org.lokro.dark/contents/layouts/org.kde.plasma.desktop-layout.js)"
    else
        script='var ds = desktops(); var hubKept = false; for (var i = 0; i < ds.length; i++) { ds[i].wallpaperPlugin = "org.lokro.slashes"; ds[i].currentConfigGroup = ["Wallpaper", "org.lokro.slashes", "General"]; ds[i].writeConfig("accentColor", "#f4f4f5"); var memoryWidgets = ds[i].widgets("org.kde.plasma.systemmonitor.memory"); for (var j = 0; j < memoryWidgets.length; ++j) { memoryWidgets[j].remove(); } var hubs = ds[i].widgets("org.lokro.hub"); for (var h = 0; h < hubs.length; ++h) { if (!hubKept) { hubKept = true; } else { hubs[h].remove(); } } }'
    fi
    layout_applied=false
    for _attempt in {1..10}; do
        if qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script" >/dev/null 2>&1; then
            layout_applied=true
            break
        fi
        sleep 1
    done
elif [[ "$fresh_layout" == true ]]; then
    layout_applied=false
fi
[[ "$layout_applied" == true ]] || exit 0
touch "$stamp"
