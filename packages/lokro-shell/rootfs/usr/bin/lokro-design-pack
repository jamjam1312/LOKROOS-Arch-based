#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Validate, install and apply user-scoped LOKRO design packs."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path, PurePosixPath

MAX_FILES = 2_000
MAX_FILE_SIZE = 32 * 1024 * 1024
MAX_TOTAL_SIZE = 100 * 1024 * 1024
ID_PATTERN = re.compile(r"^[a-z0-9]+(?:[.-][a-z0-9]+)+$")
VERSION_PATTERN = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$")
COMPONENT_PATTERN = re.compile(r"^[A-Za-z0-9._-]+$")
COLOR_PATTERN = re.compile(r"^[A-Za-z0-9._ -]+$")
WALLPAPER_EXTENSIONS = {".png", ".jpg", ".jpeg", ".webp"}
ROOT_DOCUMENTS = {
    "design.json",
    "README",
    "README.md",
    "LICENSE",
    "LICENSE.txt",
    "preview.png",
    "preview.jpg",
    "preview.jpeg",
    "preview.webp",
}
ROOT_KEYS = {
    "$schema",
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "license",
    "description",
    "plasma",
}
REQUIRED_ROOT_KEYS = {
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "license",
    "description",
    "plasma",
}
PLASMA_KEYS = {
    "lookAndFeel",
    "colorScheme",
    "cursorTheme",
    "cursorSize",
    "wallpaperPlugin",
    "wallpaper",
}


class PackError(RuntimeError):
    pass


def data_home() -> Path:
    return Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))


def user_pack_root() -> Path:
    return data_home() / "lokro" / "design-packs"


def system_pack_root() -> Path:
    override = os.environ.get("LOKRO_SYSTEM_DESIGN_PACKS")
    return Path(override) if override else Path("/usr/share/lokro/design-packs")


def safe_relative_path(raw: str) -> PurePosixPath:
    if "\\" in raw or "\x00" in raw:
        raise PackError(f"unsafe path: {raw!r}")
    path = PurePosixPath(raw)
    if path.is_absolute() or not path.parts or any(part in {"", ".", ".."} for part in path.parts):
        raise PackError(f"unsafe path: {raw!r}")
    return path


def validate_payload_path(relative: PurePosixPath) -> None:
    name = relative.as_posix()
    if len(name) > 240:
        raise PackError(f"path is too long: {name}")
    if len(relative.parts) == 1 and name in ROOT_DOCUMENTS:
        return
    if len(relative.parts) >= 3 and relative.parts[:2] == ("payload", "color-schemes"):
        if relative.suffix.lower() != ".colors":
            raise PackError(f"only .colors files are allowed under payload/color-schemes: {name}")
        return
    if len(relative.parts) >= 3 and relative.parts[:2] == ("payload", "wallpapers"):
        if relative.suffix.lower() not in WALLPAPER_EXTENSIONS:
            raise PackError(f"unsupported wallpaper image type: {name}")
        return
    raise PackError(f"unsupported file location in design pack: {name}")


def inspect_tree(root: Path) -> None:
    file_count = 0
    total_size = 0
    for path in root.rglob("*"):
        relative = safe_relative_path(path.relative_to(root).as_posix())
        if path.is_symlink():
            raise PackError(f"links are not allowed: {relative.as_posix()}")
        info = path.stat(follow_symlinks=False)
        if path.is_dir():
            continue
        if not stat.S_ISREG(info.st_mode):
            raise PackError(f"only regular files are allowed: {relative.as_posix()}")
        if info.st_mode & 0o111:
            raise PackError(f"executable files are not allowed: {relative.as_posix()}")
        validate_payload_path(relative)
        file_count += 1
        total_size += info.st_size
        if info.st_size > MAX_FILE_SIZE:
            raise PackError(f"file exceeds the 32 MiB limit: {relative.as_posix()}")
        if file_count > MAX_FILES or total_size > MAX_TOTAL_SIZE:
            raise PackError("pack exceeds the file-count or 100 MiB total-size limit")


def bounded_string(manifest: dict, key: str, maximum: int) -> str:
    value = manifest.get(key)
    if not isinstance(value, str) or not value.strip() or len(value) > maximum:
        raise PackError(f"{key} must be a non-empty string of at most {maximum} characters")
    return value


def load_manifest(root: Path) -> dict:
    manifest_path = root / "design.json"
    if not manifest_path.is_file() or manifest_path.is_symlink():
        raise PackError("design.json is missing or is not a regular file")
    if manifest_path.stat().st_size > 128 * 1024:
        raise PackError("design.json exceeds 128 KiB")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise PackError(f"cannot parse design.json: {error}") from error
    if not isinstance(manifest, dict):
        raise PackError("design.json must contain one JSON object")
    missing = REQUIRED_ROOT_KEYS - manifest.keys()
    unknown = manifest.keys() - ROOT_KEYS
    if missing:
        raise PackError(f"design.json is missing: {', '.join(sorted(missing))}")
    if unknown:
        raise PackError(f"design.json has unknown keys: {', '.join(sorted(unknown))}")
    if manifest.get("schemaVersion") != 1:
        raise PackError("only schemaVersion 1 is supported")
    pack_id = bounded_string(manifest, "id", 128)
    if not ID_PATTERN.fullmatch(pack_id):
        raise PackError("id must be a lowercase reverse-DNS-style identifier")
    version = bounded_string(manifest, "version", 64)
    if not VERSION_PATTERN.fullmatch(version):
        raise PackError("version must use semantic version syntax")
    bounded_string(manifest, "name", 80)
    bounded_string(manifest, "author", 120)
    bounded_string(manifest, "license", 80)
    bounded_string(manifest, "description", 500)
    plasma = manifest.get("plasma")
    if not isinstance(plasma, dict) or not plasma:
        raise PackError("plasma must be a non-empty object")
    unknown_plasma = plasma.keys() - PLASMA_KEYS
    if unknown_plasma:
        raise PackError(f"plasma has unknown keys: {', '.join(sorted(unknown_plasma))}")
    for key in ("lookAndFeel", "cursorTheme", "wallpaperPlugin"):
        if key in plasma and (not isinstance(plasma[key], str) or not COMPONENT_PATTERN.fullmatch(plasma[key])):
            raise PackError(f"plasma.{key} contains an invalid component identifier")
    if "colorScheme" in plasma and (
        not isinstance(plasma["colorScheme"], str) or not COLOR_PATTERN.fullmatch(plasma["colorScheme"])
    ):
        raise PackError("plasma.colorScheme contains unsupported characters")
    if "cursorSize" in plasma and (
        isinstance(plasma["cursorSize"], bool)
        or not isinstance(plasma["cursorSize"], int)
        or not 16 <= plasma["cursorSize"] <= 96
    ):
        raise PackError("plasma.cursorSize must be an integer from 16 through 96")
    if "wallpaper" in plasma:
        if not isinstance(plasma["wallpaper"], str):
            raise PackError("plasma.wallpaper must be a relative path")
        relative = safe_relative_path(plasma["wallpaper"])
        if relative.parts[:2] != ("payload", "wallpapers") or relative.suffix.lower() not in WALLPAPER_EXTENSIONS:
            raise PackError("plasma.wallpaper must reference an allowed payload/wallpapers image")
        target = root.joinpath(*relative.parts)
        if not target.is_file() or target.is_symlink():
            raise PackError(f"referenced wallpaper does not exist: {relative.as_posix()}")
    return manifest


def validate_pack(root: Path) -> dict:
    if not root.is_dir() or root.is_symlink():
        raise PackError("the design pack must be a real directory")
    inspect_tree(root)
    return load_manifest(root)


def safe_extract_archive(archive: Path, destination: Path) -> Path:
    if not archive.is_file() or archive.suffix.lower() != ".lokrodesign":
        raise PackError("archives must be ZIP-compatible files ending in .lokrodesign")
    if not zipfile.is_zipfile(archive):
        raise PackError("the .lokrodesign file is not a valid ZIP archive")
    count = 0
    total = 0
    with zipfile.ZipFile(archive) as package:
        for entry in package.infolist():
            relative = safe_relative_path(entry.filename.rstrip("/"))
            mode = entry.external_attr >> 16
            if stat.S_ISLNK(mode):
                raise PackError(f"archive links are not allowed: {relative.as_posix()}")
            if entry.is_dir():
                continue
            count += 1
            total += entry.file_size
            if entry.file_size > MAX_FILE_SIZE or count > MAX_FILES or total > MAX_TOTAL_SIZE:
                raise PackError("archive exceeds the file-count or size limits")
            if mode & 0o111:
                raise PackError(f"archive executable files are not allowed: {relative.as_posix()}")
            target = destination.joinpath(*relative.parts)
            target.parent.mkdir(parents=True, exist_ok=True)
            with package.open(entry) as source, target.open("xb") as output:
                shutil.copyfileobj(source, output, length=1024 * 1024)
    entries = list(destination.iterdir())
    if (destination / "design.json").is_file():
        return destination
    if len(entries) == 1 and entries[0].is_dir() and (entries[0] / "design.json").is_file():
        return entries[0]
    raise PackError("archive must contain design.json at its root or in one top-level directory")


def resolve_source(source: Path, temporary: Path) -> Path:
    source = source.expanduser().resolve()
    if source.is_dir():
        return source
    return safe_extract_archive(source, temporary)


def install_assets(installed: Path, pack_id: str) -> None:
    colors = installed / "payload" / "color-schemes"
    if colors.is_dir():
        destination = data_home() / "color-schemes"
        destination.mkdir(parents=True, exist_ok=True)
        for source in colors.rglob("*.colors"):
            relative_name = "-".join(source.relative_to(colors).parts)
            shutil.copy2(source, destination / f"{pack_id}-{relative_name}")
    wallpapers = installed / "payload" / "wallpapers"
    if wallpapers.is_dir():
        destination = data_home() / "wallpapers" / pack_id
        replacement = destination.with_name(f".{pack_id}.new")
        shutil.rmtree(replacement, ignore_errors=True)
        shutil.copytree(wallpapers, replacement)
        shutil.rmtree(destination, ignore_errors=True)
        os.replace(replacement, destination)


def install_pack(source: Path) -> dict:
    with tempfile.TemporaryDirectory(prefix="lokro-design-pack-") as temporary_name:
        root = resolve_source(source, Path(temporary_name))
        manifest = validate_pack(root)
        destination_root = user_pack_root()
        destination_root.mkdir(parents=True, exist_ok=True)
        destination = destination_root / manifest["id"]
        staging = Path(tempfile.mkdtemp(prefix=f".{manifest['id']}.", dir=destination_root))
        backup = destination.with_name(f".{manifest['id']}.previous")
        moved_existing = False
        try:
            shutil.copytree(root, staging, dirs_exist_ok=True, copy_function=shutil.copy2)
            validate_pack(staging)
            shutil.rmtree(backup, ignore_errors=True)
            if destination.exists():
                os.replace(destination, backup)
                moved_existing = True
            try:
                os.replace(staging, destination)
            except OSError:
                if moved_existing and backup.exists() and not destination.exists():
                    os.replace(backup, destination)
                raise
            shutil.rmtree(backup, ignore_errors=True)
        finally:
            shutil.rmtree(staging, ignore_errors=True)
        install_assets(destination, manifest["id"])
        return manifest


def all_packs() -> dict[str, tuple[dict, Path, str]]:
    packs: dict[str, tuple[dict, Path, str]] = {}
    for origin, root in (("system", system_pack_root()), ("user", user_pack_root())):
        if not root.is_dir():
            continue
        for candidate in sorted(root.iterdir()):
            if not candidate.is_dir() or candidate.is_symlink() or candidate.name.startswith("."):
                continue
            try:
                manifest = validate_pack(candidate)
            except PackError as error:
                print(f"warning: ignoring invalid {origin} pack {candidate}: {error}", file=sys.stderr)
                continue
            if candidate.name != manifest["id"]:
                print(f"warning: ignoring {origin} pack whose directory does not match its id: {candidate}", file=sys.stderr)
                continue
            packs[manifest["id"]] = (manifest, candidate, origin)
    return packs


def run_component(command: list[str], errors: list[str]) -> None:
    executable = shutil.which(command[0])
    if executable is None:
        errors.append(f"missing command: {command[0]}")
        return
    result = subprocess.run([executable, *command[1:]], check=False, capture_output=True, text=True)
    if result.returncode:
        message = (result.stderr or result.stdout).strip()
        errors.append(f"{' '.join(command)} failed{': ' + message if message else ''}")


def apply_pack(pack_id: str) -> dict:
    packs = all_packs()
    if pack_id not in packs:
        raise PackError(f"design pack is not installed: {pack_id}")
    manifest, root, _origin = packs[pack_id]
    plasma = manifest["plasma"]
    errors: list[str] = []
    if "lookAndFeel" in plasma:
        run_component(["plasma-apply-lookandfeel", "--apply", plasma["lookAndFeel"]], errors)
    if "colorScheme" in plasma:
        run_component(["plasma-apply-colorscheme", plasma["colorScheme"]], errors)
    if "cursorTheme" in plasma:
        run_component(
            ["kwriteconfig6", "--file", "kcminputrc", "--group", "Mouse", "--key", "cursorTheme", plasma["cursorTheme"]],
            errors,
        )
    if "cursorSize" in plasma:
        run_component(
            ["kwriteconfig6", "--file", "kcminputrc", "--group", "Mouse", "--key", "cursorSize", str(plasma["cursorSize"])],
            errors,
        )
    wallpaper_plugin = plasma.get("wallpaperPlugin")
    wallpaper_url = None
    if "wallpaper" in plasma:
        source = root.joinpath(*PurePosixPath(plasma["wallpaper"]).parts).resolve()
        wallpaper_plugin = "org.kde.image"
        wallpaper_url = source.as_uri()
    if wallpaper_plugin:
        plugin_json = json.dumps(wallpaper_plugin)
        script = (
            "var ds=desktops(); for (var i=0; i<ds.length; i++) {"
            f"ds[i].wallpaperPlugin={plugin_json};"
            f"ds[i].currentConfigGroup=['Wallpaper',{plugin_json},'General'];"
        )
        if wallpaper_url:
            script += f"ds[i].writeConfig('Image',{json.dumps(wallpaper_url)});"
        script += "}"
        run_component(
            ["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", script],
            errors,
        )
    if errors:
        raise PackError("; ".join(errors))
    state = data_home() / "lokro" / "design-packs" / "applied.json"
    state.parent.mkdir(parents=True, exist_ok=True)
    state.write_text(json.dumps({"id": pack_id, "version": manifest["version"]}, indent=2) + "\n", encoding="utf-8")
    return manifest


def command_list(as_json: bool) -> None:
    rows = [
        {"id": pack_id, "name": manifest["name"], "version": manifest["version"], "origin": origin}
        for pack_id, (manifest, _root, origin) in sorted(all_packs().items())
    ]
    if as_json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        for row in rows:
            print(f"{row['id']}\t{row['name']}\t{row['version']}\t{row['origin']}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Manage safe, user-scoped LOKRO design packs")
    subparsers = parser.add_subparsers(dest="command", required=True)
    list_parser = subparsers.add_parser("list", help="list system and user design packs")
    list_parser.add_argument("--json", action="store_true", help="emit JSON")
    validate_parser = subparsers.add_parser("validate", help="validate a folder or .lokrodesign archive")
    validate_parser.add_argument("source", type=Path)
    install_parser = subparsers.add_parser("install", help="install a folder or .lokrodesign archive for this user")
    install_parser.add_argument("source", type=Path)
    apply_parser = subparsers.add_parser("apply", help="apply an installed pack to the current Plasma session")
    apply_parser.add_argument("id")
    arguments = parser.parse_args()
    try:
        if arguments.command == "list":
            command_list(arguments.json)
        elif arguments.command == "validate":
            with tempfile.TemporaryDirectory(prefix="lokro-design-pack-") as temporary_name:
                root = resolve_source(arguments.source, Path(temporary_name))
                manifest = validate_pack(root)
            print(f"valid: {manifest['id']} {manifest['version']} — {manifest['name']}")
        elif arguments.command == "install":
            manifest = install_pack(arguments.source)
            print(f"installed: {manifest['id']} {manifest['version']} — {manifest['name']}")
        elif arguments.command == "apply":
            manifest = apply_pack(arguments.id)
            print(f"applied: {manifest['id']} {manifest['version']} — {manifest['name']}")
            print("A cursor change may require signing out and back in before every application uses it.")
    except (PackError, OSError, zipfile.BadZipFile, zipfile.LargeZipFile) as error:
        print(f"lokro-design-pack: error: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
