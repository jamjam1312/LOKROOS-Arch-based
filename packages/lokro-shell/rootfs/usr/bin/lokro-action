#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

action="${1:-}"
action="${action#lokro-action:}"
action="${action%%\?*}"

launch() {
    "$@" >/dev/null 2>&1 &
}

apply_design() {
    local pack_id="$1"
    (
        local output
        if output="$(lokro-design-pack apply "$pack_id" 2>&1)"; then
            kdialog --title 'LOKRO Design' --msgbox "$output" >/dev/null 2>&1 || true
        else
            kdialog --title 'LOKRO Design' --error "$output" >/dev/null 2>&1 || true
        fi
    ) &
}

case "$action" in
    search)
        if [[ "${XDG_CURRENT_DESKTOP:-}" == *Hyprland* ]] && command -v wofi >/dev/null 2>&1; then
            launch wofi --show drun --allow-images
        else
            launch krunner
        fi
        ;;
    taskmanager) launch plasma-systemmonitor ;;
    files) launch dolphin ;;
    terminal) launch konsole ;;
    settings) launch lokro-settings ;;
    system-settings) launch systemsettings ;;
    users) launch systemsettings kcm_users ;;
    appearance) launch systemsettings kcm_lookandfeel ;;
    design-packs) launch lokro-design-pack-gui ;;
    design-animated) apply_design org.lokro.monochrome ;;
    design-eclipse) apply_design org.lokro.eclipse ;;
    design-lunar) apply_design org.lokro.lunar ;;
    credits) launch lokro-credits ;;
    app-store) launch lokro-store ;;
    wallpaper)
        launch kdialog --title "LOKRO Hintergrund" --msgbox \
            'Klicke mit der rechten Maustaste auf eine freie Stelle des Plasma-Desktops und wähle "Desktop und Hintergrund einrichten". Dort kannst du Bild, Animation und Darstellung ändern.'
        ;;
    network) launch systemsettings kcm_networkmanagement ;;
    bluetooth) launch systemsettings kcm_bluetooth ;;
    input) launch systemsettings kcm_keyboard ;;
    cursor) launch systemsettings kcm_cursortheme ;;
    shortcuts) launch systemsettings kcm_keys ;;
    power) launch systemsettings kcm_powerdevilprofilesconfig ;;
    widgets)
        qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
            'showWidgetExplorer()' >/dev/null 2>&1 || true
        ;;
    discover) launch plasma-discover ;;
    link-installer) launch lokro-link-installer-gui ;;
    media) launch lokro-media ;;
    boot) launch lokro-boot-manager gui ;;
    updates) launch lokro-update-gui ;;
    partitions) launch partitionmanager ;;
    tiling)
        launch kdialog --title "LOKRO Fensteraufteilung" --msgbox \
            "Plasma: Drücke Meta+T, um den KWin-Kachel-Editor zu öffnen. Ziehe danach ein Fenster mit gedrückter Umschalttaste in eine Zone. Die optionale Hyprland-Sitzung kann beim Anmelden ausgewählt werden."
        ;;
    desktop-session)
        launch kdialog --title "LOKRO Desktop-Sitzungen" --msgbox \
            "Plasma ist der unterstützte Standard. Wenn Hyprland im Installer gewählt wurde, kannst du am SDDM-Anmeldebildschirm über das Sitzungsmenü zwischen Plasma und Hyprland wechseln."
        ;;
    installer)
        if [[ -x /usr/local/bin/lokro-live-installer ]]; then
            launch /usr/local/bin/lokro-live-installer
        else
            launch kdialog --title "LOKRO OS Installer" --sorry \
                "Der Installer ist nur im gestarteten LOKRO-Live-System verfügbar."
        fi
        ;;
    steam)
        if command -v steam >/dev/null 2>&1; then launch steam; else launch plasma-discover; fi
        ;;
    minecraft)
        if command -v prismlauncher >/dev/null 2>&1; then launch prismlauncher; else launch plasma-discover; fi
        ;;
    theme-dark) plasma-apply-colorscheme LokroDark >/dev/null ;;
    theme-light) plasma-apply-colorscheme BreezeLight >/dev/null ;;
    lock)
        if [[ "${XDG_CURRENT_DESKTOP:-}" == *Hyprland* ]] && command -v hyprlock >/dev/null 2>&1; then
            launch hyprlock
        else
            loginctl lock-session
        fi
        ;;
    suspend) systemctl suspend ;;
    reboot) systemctl reboot ;;
    shutdown) systemctl poweroff ;;
    *) exit 2 ;;
esac
