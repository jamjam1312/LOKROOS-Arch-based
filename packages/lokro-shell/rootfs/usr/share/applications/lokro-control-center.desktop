[Desktop Entry]
Type=Application
Name=LOKRO Settings
Name[de]=LOKRO-Einstellungen
Comment=Configure appearance, cursor, devices, users, shortcuts and power
Comment[de]=Aussehen, Cursor, Geräte, Benutzer, Tastenkürzel und Energie grafisch einstellen
Exec=lokro-action settings
Icon=preferences-system
Terminal=false
Categories=Settings;
Keywords=settings;appearance;theme;design;wallpaper;cursor;users;network;bluetooth;power;shortcuts;widgets;
Keywords[de]=Einstellungen;Aussehen;Design;Hintergrund;Cursor;Benutzer;Netzwerk;Bluetooth;Energie;Tastenkürzel;Widgets;
Actions=Appearance;DesignPacks;Wallpaper;Cursor;Users;Network;Bluetooth;Shortcuts;Power;Widgets;DesktopSession;

