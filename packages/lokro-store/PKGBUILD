# SPDX-License-Identifier: GPL-3.0-or-later
pkgname=lokro-store
pkgver=0.1.0.alpha6
_upstream_version=0.1.0-alpha.6
pkgrel=1
pkgdesc='Validated application and design catalog for LOKRO OS'
arch=('any')
url='https://github.com/jamjam1312/LOKROOS-Appstore-githubconnection'
license=('CC0-1.0' 'Apache-2.0' 'MIT' 'GPL-2.0-or-later' 'GPL-3.0-only' 'GPL-3.0-or-later' 'LGPL-3.0-or-later' 'MPL-2.0')
depends=('python' 'pyside6' 'flatpak')
optdepends=('lokro-shell: validate and install LOKRO design packs')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$_upstream_version.tar.gz::https://codeload.github.com/jamjam1312/LOKROOS-Appstore-githubconnection/tar.gz/refs/tags/v$_upstream_version")
sha256sums=('5819d364577a421c58c189a32b2523bf3bd422df3f31f93f4939106bc475c37c')

build() {
  cd "LOKROOS-Appstore-githubconnection-$_upstream_version"
  python -m build --wheel --no-isolation
}

package() {
  cd "LOKROOS-Appstore-githubconnection-$_upstream_version"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 catalog/v1/catalog.json "$pkgdir/usr/share/lokro-store/catalog/v1/catalog.json"
  install -Dm644 catalog/v1/catalog.schema.json "$pkgdir/usr/share/lokro-store/catalog/v1/catalog.schema.json"
  install -Dm644 packaging/linux/org.lokro.Store.desktop "$pkgdir/usr/share/applications/org.lokro.Store.desktop"
  install -Dm644 assets/lokro-store.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/lokro-store.svg"
  install -d "$pkgdir/usr/share/lokro-store/assets/icons"
  cp -a assets/icons/*.png "$pkgdir/usr/share/lokro-store/assets/icons/"
  cp -a assets/icons/*.svg "$pkgdir/usr/share/lokro-store/assets/icons/"
  install -Dm644 assets/icons/SOURCES.md "$pkgdir/usr/share/licenses/$pkgname/ICON-SOURCES.md"
}
